# API keys and secrets
ctrl/pelican.ini

# Sysop password and sensitive BBS config
ctrl/main.ini

# Live weather/tide snapshot regenerated every 30 min by cron
ctrl/pelican_weather.txt
data/weather_tides.txt

# QWKnet hub passwords (qnet-ftp.ini under ctrl/modopts.d/)
